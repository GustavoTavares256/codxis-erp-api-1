generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Company {
  id                    String                 @id @default(uuid())
  name                  String
  fantasyName           String?
  document              String?                @unique
  email                 String?
  phone                 String?
  website               String?
  address               String?                @db.Text
  logoUrl               String?                @db.LongText

  plan                  CompanyPlan            @default(FREE)
  status                CompanyStatus          @default(TRIAL)
  licenseExpiresAt      DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  categories            Category[]
  customers             Customer[]
  financialTransactions FinancialTransaction[]
  receivables           Receivable[]
  paymentReceipts       PaymentReceipt[]
  products              Product[]
  sales                 Sale[]
  stockMovements        StockMovement[]
  suppliers             Supplier[]
  users                 User[]
  auditLogs             AuditLog[]

  @@map("companies")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(EMPLOYEE)
  companyId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sales     Sale[]
  paymentReceipts PaymentReceipt[]
  company   Company? @relation(fields: [companyId], references: [id])
  auditLogs AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@index([companyId], map: "users_companyId_fkey")
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "password_reset_tokens_userId_fkey")
  @@map("password_reset_tokens")
}

model Category {
  id        String    @id @default(uuid())
  name      String
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]

  @@index([companyId], map: "categories_companyId_fkey")
  @@map("categories")
}

model Supplier {
  id        String    @id @default(uuid())
  name      String
  document  String?
  email     String?
  phone     String?
  companyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
  company   Company   @relation(fields: [companyId], references: [id])

  @@index([companyId], map: "suppliers_companyId_fkey")
  @@map("suppliers")
}

model Product {
  id                      String          @id @default(uuid())
  code                    String?
  name                    String
  description             String?
  sku                     String?
  salePackage             String?
  salePackageQuantity     Decimal?        @db.Decimal(10, 3)
  purchasePrice           Decimal?        @db.Decimal(10, 2)
  costPrice               Decimal         @db.Decimal(10, 2)
  markupPercent           Decimal?        @db.Decimal(10, 2)
  salePrice               Decimal         @db.Decimal(10, 2)
  profitMarginPercent     Decimal?        @db.Decimal(10, 2)
  barcode                 String?
  taxableBarcode          String?
  captureWeightOnScale    Boolean         @default(false)
  stock                   Int             @default(0) @map("quantity")
  minimumStock            Int             @default(0)
  expirationDate          DateTime?
  commissionPercent       Decimal?        @db.Decimal(10, 2)
  factoryReference        String?
  grossWeightKg           Decimal?        @db.Decimal(10, 3)
  netWeightKg             Decimal?        @db.Decimal(10, 3)
  lengthCm                Decimal?        @db.Decimal(10, 2)
  widthCm                 Decimal?        @db.Decimal(10, 2)
  heightCm                Decimal?        @db.Decimal(10, 2)
  brand                   String?
  supplierPackage         String?
  supplierPackageQuantity Decimal?        @db.Decimal(10, 3)
  sizeColorGrid           String?         @db.Text
  imageUrl                String?         @db.LongText
  unit                    ProductUnit     @default(UN)
  isActive                Boolean         @default(true)
  companyId               String
  categoryId              String?
  supplierId              String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  category                Category?       @relation(fields: [categoryId], references: [id])
  company                 Company         @relation(fields: [companyId], references: [id])
  supplier                Supplier?       @relation(fields: [supplierId], references: [id])
  saleItems               SaleItem[]
  stockMovements          StockMovement[]

  @@index([categoryId], map: "products_categoryId_fkey")
  @@index([code], map: "products_code_idx")
  @@index([companyId], map: "products_companyId_fkey")
  @@index([supplierId], map: "products_supplierId_fkey")
  @@map("products")
}

model Customer {
  id        String   @id @default(uuid())
  name      String
  document  String?
  email     String?
  phone     String?
  companyId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
  sales     Sale[]
  receivables Receivable[]

  @@index([companyId], map: "customers_companyId_fkey")
  @@map("customers")
}

model Sale {
  id                   String                @id @default(uuid())
  totalAmount          Decimal               @db.Decimal(10, 2)
  paymentMethod        PaymentMethod
  paymentCondition     PaymentCondition       @default(CASH)
  status               SaleStatus            @default(COMPLETED)
  companyId            String
  customerId           String?
  userId               String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  financialTransaction FinancialTransaction?
  receivable           Receivable?
  items                SaleItem[]
  company              Company               @relation(fields: [companyId], references: [id])
  customer             Customer?             @relation(fields: [customerId], references: [id])
  user                 User                  @relation(fields: [userId], references: [id])

  @@index([companyId], map: "sales_companyId_fkey")
  @@index([customerId], map: "sales_customerId_fkey")
  @@index([userId], map: "sales_userId_fkey")
  @@map("sales")
}

model Receivable {
  id             String           @id @default(uuid())
  description    String
  totalAmount    Decimal          @db.Decimal(10, 2)
  status         ReceivableStatus @default(PENDING)
  companyId      String
  customerId     String?
  saleId         String?          @unique
  paymentMethod  PaymentMethod    @default(PIX)
  notes           String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  company        Company          @relation(fields: [companyId], references: [id])
  customer       Customer?        @relation(fields: [customerId], references: [id])
  sale           Sale?            @relation(fields: [saleId], references: [id])
  installments   PaymentInstallment[]

  @@index([companyId])
  @@index([customerId])
  @@map("receivables")
}

model PaymentInstallment {
  id            String            @id @default(uuid())
  number        Int
  amount        Decimal           @db.Decimal(10, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(10, 2)
  dueDate       DateTime
  status        InstallmentStatus @default(PENDING)
  receivableId  String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  receivable    Receivable        @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  receipts      PaymentReceipt[]

  @@unique([receivableId, number])
  @@index([dueDate])
  @@map("payment_installments")
}

model PaymentReceipt {
  id             String             @id @default(uuid())
  amount         Decimal            @db.Decimal(10, 2)
  paymentMethod  PaymentMethod
  receivedAt     DateTime
  notes          String?            @db.Text
  installmentId  String
  companyId      String
  userId         String
  createdAt      DateTime           @default(now())
  installment    PaymentInstallment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  company        Company            @relation(fields: [companyId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  financialTransaction FinancialTransaction?

  @@index([companyId])
  @@index([installmentId])
  @@map("payment_receipts")
}

model SaleItem {
  id          String      @id @default(uuid())
  quantity    Int
  unit        ProductUnit @default(UN)
  productName String
  unitPrice   Decimal     @db.Decimal(10, 2)
  discount    Decimal     @default(0) @db.Decimal(10, 2)
  subtotal    Decimal     @db.Decimal(10, 2)
  saleId      String
  productId   String
  createdAt   DateTime    @default(now())
  product     Product     @relation(fields: [productId], references: [id])
  sale        Sale        @relation(fields: [saleId], references: [id])

  @@index([productId], map: "sale_items_productId_fkey")
  @@index([saleId], map: "sale_items_saleId_fkey")
  @@map("sale_items")
}

model StockMovement {
  id        String            @id @default(uuid())
  type      StockMovementType
  quantity  Int
  reason    String?
  productId String
  companyId String
  createdAt DateTime          @default(now())
  company   Company           @relation(fields: [companyId], references: [id])
  product   Product           @relation(fields: [productId], references: [id])

  @@index([companyId], map: "stock_movements_companyId_fkey")
  @@index([productId], map: "stock_movements_productId_fkey")
  @@map("stock_movements")
}

model FinancialTransaction {
  id          String                     @id @default(uuid())
  description String
  amount      Decimal                    @db.Decimal(10, 2)
  type        FinancialTransactionType
  status      FinancialTransactionStatus @default(PENDING)
  dueDate     DateTime?
  paidAt      DateTime?
  companyId   String
  saleId      String?                    @unique
  paymentReceiptId String?               @unique
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  company     Company                    @relation(fields: [companyId], references: [id])
  sale        Sale?                      @relation(fields: [saleId], references: [id])
  paymentReceipt PaymentReceipt?         @relation(fields: [paymentReceiptId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "financial_transactions_companyId_fkey")
  @@map("financial_transactions")
}

model AuditLog {
  id        String         @id @default(uuid())
  action    AuditLogAction
  entity    String
  entityId  String
  oldValue  Json?
  newValue  Json?
  companyId String?
  userId    String?
  createdAt DateTime       @default(now())

  company   Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId], map: "audit_logs_companyId_fkey")
  @@index([userId], map: "audit_logs_userId_fkey")
  @@map("audit_logs")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum StockMovementType {
  IN
  OUT
  ADJUSTMENT
}

enum PaymentMethod {
  PIX
  CASH
  CARD
}

enum PaymentCondition {
  CASH
  INSTALLMENT
}

enum ReceivableStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum InstallmentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELED
}

enum SaleStatus {
  PENDING
  COMPLETED
  CANCELED
}

enum FinancialTransactionType {
  INCOME
  EXPENSE
}

enum FinancialTransactionStatus {
  PENDING
  PAID
  CANCELED
}

enum CompanyStatus {
  TRIAL
  ACTIVE
  BLOCKED
  EXPIRED
}

enum CompanyPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

enum ProductUnit {
  UN
  CX
  PC
  KG
  G
  TON
  L
  ML
  M
  CM
  M2
  M3
  SC
  FD
}

enum AuditLogAction {
  COMPANY_STATUS_UPDATED
  COMPANY_LICENSE_UPDATED
  COMPANY_PLAN_UPDATED
  COMPANY_IMPERSONATION_STARTED
  COMPANY_IMPERSONATION_ENDED
  SUPPORT_ACTION_EXECUTED
}
